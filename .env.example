# AegisVote Environment Configuration Template
# Copy this file to .env and configure for your deployment environment

# Server Configuration
PORT=8080
HOST=0.0.0.0
STATIC_DIR=frontend/dist

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=secure_voting_db
DB_USER=subscribly_user
DB_PASSWORD=your_secure_password_here

# Cryptographic Secrets (generate with `openssl rand -hex 32`)
JWT_SECRET=production_hmac_secret_key_change_me_in_prod_2026
RECEIPT_SECRET=production_ballot_receipt_salt_2026
