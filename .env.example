# AegisVote Environment Configuration Template
# For local demo/development: copy this file to .env and adjust credentials
# For production: all secrets must be at least 32 characters, generated via OpenSSL

# Application Mode: 'development', 'demo', or 'production'
APP_ENV=development

# Server Configuration
PORT=8080
HOST=127.0.0.1
STATIC_DIR=frontend/dist

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aegisvote_audit_trackb
DB_USER=subscribly_user
DB_PASSWORD=your_secure_db_password_here

# Cryptographic Secrets (REQUIRED in production: generate with `openssl rand -hex 32`)
JWT_SECRET=demo_hmac_secret_key_minimum_32_characters_long_2026
RECEIPT_SECRET=demo_ballot_receipt_salt_minimum_32_chars_2026
